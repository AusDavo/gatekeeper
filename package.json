{
  "name": "gatekeeper",
  "version": "1.2.0",
  "description": "Bitcoin multisig wallet signature verification tool",
  "scripts": {
    "build": "npm run build:icons && esbuild main.js --bundle --platform=browser --format=iife --inject:scripts/buffer-shim.js --outfile=bundled.js",
    "build:icons": "node scripts/build-icons.js",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.1.1",
    "@noble/hashes": "^2.4.0",
    "bip32": "^5.0.1",
    "bip322-js": "^4.0.0",
    "bitcoinjs-lib": "^7.0.2",
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.1.1"
  }
}
